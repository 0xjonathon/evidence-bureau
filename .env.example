# Node.js >= 22. Keys stay on the server. Never put them in public/.
PORT=4173
HOST=127.0.0.1
# 腾讯云元宝搜索：服务 API KEY 方式
TENCENTCLOUD_WSA_APIKEY=
# Any OpenAI-compatible chat completions provider, including a self-hosted one.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Optional independent reviewer model; falls back to LLM_MODEL (two-pass, same model).
LLM_REVIEW_MODEL=
# Optional vision-capable model on the same configured endpoint.
LLM_VISION_MODEL=

# StepFun and other providers with JSON mode / reasoning support (optional).
LLM_JSON_MODE=false
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=8192

# Storage (Upstash Redis REST). Without these, state lives in memory and is lost on restart.
# On Vercel, add an Upstash Redis from the Marketplace; KV_REST_API_URL / KV_REST_API_TOKEN are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Developer machines using a Clash/Surge "fake-ip" proxy resolve every host to 198.18.0.0/15, which the
# full-text fetcher blocks by default. Set to 1 locally ONLY; it is ignored on Vercel and in production.
# EB_ALLOW_FAKE_IP=1
# Disable the full-text quote check or the 24h claim cache if needed.
# EB_DISABLE_FULLTEXT=1
# EB_DISABLE_CACHE=1
