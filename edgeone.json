{
  "cloudFunctions": {
    "nodejs": { "maxDuration": 120 }
  },
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-xKC5iFyQS8Rg2vT8X0L9L5p2MBtIeO2cFdQA+73n0ZA='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/vendor/*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "schedules": [
    { "name": "daily-watch", "cron": "17 1 * * *", "path": "/api/cron-watch", "method": "POST", "timezone": "Asia/Shanghai" }
  ]
}
